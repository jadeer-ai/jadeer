# ═══════════════════════════════════════════════════════════════════════════
# JADEER PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ═══════════════════════════════════════════════════════════════════════════

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/jadeer_dev?schema=public"

# ── Multi-Provider Social OAuth Credentials ───────────────────────────────

# 1. Google OAuth (OpenID Connect + Profile)
GOOGLE_CLIENT_ID="jadeer-google-client-id-2026.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:5173/api/auth/google/callback"

# 2. GitHub OAuth (Developer Dossier & Repository Telemetry)
GITHUB_CLIENT_ID="Ov23lig3fcJU1NU9VAFD"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"
GITHUB_CALLBACK_URL="http://localhost:5173/api/auth/github/callback"

# 3. LinkedIn OAuth (OpenID Connect / Sign In with LinkedIn)
LINKEDIN_CLIENT_ID="jadeer_linkedin_client_id_2026"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret_here"
LINKEDIN_CALLBACK_URL="http://localhost:5173/api/auth/linkedin/callback"

# 4. Apple Sign-In (Private Relay Identity Token)
APPLE_CLIENT_ID="io.jadeer.talent.signin"
APPLE_TEAM_ID="JADEERTEAM88"
APPLE_KEY_ID="KEYID88JAD"
APPLE_PRIVATE_KEY="your_apple_private_key_here"
APPLE_CALLBACK_URL="http://localhost:5173/api/auth/apple/callback"

# ── Clerk Authentication ──────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"

# ── Hosted Supabase Production Backend (Candidate Scheduling & Auth) ──────
# Project URL from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Public anon/publishable key (safe for browser client with RLS enforced)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or database passwords here.
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"


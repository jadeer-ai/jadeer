// Prisma Schema for Jadeer Platform — Phase 1
// Core tables: Users, Profiles, Job Listings, Applications & Telemetry

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  STUDENT
  GRADUATE
  EMPLOYER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  LINKEDIN
  APPLE
}

enum SoftwareTrack {
  SOFTWARE_ENGINEERING
  BACKEND
  FRONTEND
  FULLSTACK
  EMBEDDED_SYSTEMS
  MOBILE
  DEVOPS
  DATA_ENGINEERING
  AI_ML
  CYBERSECURITY
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID_LEVEL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum LocationType {
  ON_SITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  AI_INTERVIEW
  HUMAN_INTERVIEW
  PROJECT_ASSESSMENT
  SHORTLISTED
  HIRED
  REJECTED
}

enum EvaluatorType {
  AI
  HUMAN
  SYSTEM
}

enum CandidateType {
  STUDENT
  GRADUATE
}

// ═══════════════════════════════════════════════════════════════════════════
// 1. USERS & PROFILES (Single Table Architecture)
// ═══════════════════════════════════════════════════════════════════════════

/// Unified authentication and identity record for all platform users.
/// Stored in a single users table with role and candidate_type discriminators.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  role          UserRole
  candidateType CandidateType? @map("candidate_type")
  authProvider  AuthProvider   @default(EMAIL)
  isVerified        Boolean        @default(false)
  isActive          Boolean        @default(true)
  twoFactorEnabled  Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?        @map("two_factor_secret")
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  studentProfile      StudentProfile?
  companyProfile      CompanyProfile?
  expertProfile       Expert?
  candidateSessions   Session[]                      @relation("CandidateUserSessions")
  interviewAssignment CandidateInterviewAssignment?

  @@index([email])
  @@index([role])
  @@index([candidateType])
  @@map("users")
}

/// Two-factor authentication & email OTP verification state.
model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  purpose   String   @default("login")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otp_verifications")
}

/// Extended profile for students and graduates.
/// One-to-one with User (role = STUDENT | GRADUATE).
model StudentProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  fullName        String
  university      String?
  graduationYear  Int?
  softwareTrack   SoftwareTrack?
  bio             String?
  resumeUrl       String?
  githubUrl       String?
  linkedinUrl     String?
  portfolioUrl    String?
  avatarUrl       String?
  city            String?
  country         String?       @default("Saudi Arabia")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications          Application[]
  consultations         ConsultationSession[]
  assessmentSubmissions AssessmentSubmission[]
  sessions              Session[]              @relation("CandidateSessions")

  @@index([softwareTrack])
  @@index([userId])
  @@map("student_profiles")
}

/// Extended profile for employer companies.
/// One-to-one with User (role = EMPLOYER).
model CompanyProfile {
  id                            String      @id @default(cuid())
  userId                        String      @unique
  companyName                   String
  companyInitials               String?
  industry                      String?
  companySize                   String?
  location                      String?
  workModel                     LocationType @default(ON_SITE)
  website                       String?
  commercialRegistrationNumber  String?
  isCRVerified                  Boolean     @default(false)
  contactName                   String?
  contactRole                   String?
  logoUrl                       String?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListings JobListing[]

  @@index([companyName])
  @@index([userId])
  @@map("company_profiles")
}

// ═══════════════════════════════════════════════════════════════════════════
// 2. JOB LISTINGS
// ═══════════════════════════════════════════════════════════════════════════

/// Job posting created by an employer, scoped to software engineering domains.
model JobListing {
  id                      String         @id @default(cuid())
  companyId               String
  title                   String
  softwareTrack           SoftwareTrack
  seniorityLevel          SeniorityLevel
  employmentType          EmploymentType @default(FULL_TIME)
  locationType            LocationType   @default(ON_SITE)
  location                String?
  description             String
  responsibilities        String?
  requirements            String?
  skills                  String[]       // PostgreSQL array of skill tags
  status                  JobStatus      @default(DRAFT)
  minimumMatchScore       Int            @default(70)
  deadline                DateTime?
  enableAIInterview       Boolean        @default(true)
  enableProjectAssessment Boolean        @default(true)
  publishedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([companyId])
  @@index([softwareTrack])
  @@index([status])
  @@index([seniorityLevel])
  @@map("job_listings")
}

// ═══════════════════════════════════════════════════════════════════════════
// 3. APPLICATIONS & TELEMETRY
// ═══════════════════════════════════════════════════════════════════════════

/// Links a candidate to a job listing with assessment telemetry.
model Application {
  id                    String            @id @default(cuid())
  candidateId           String
  jobListingId          String
  status                ApplicationStatus @default(SUBMITTED)
  coverNote             String?

  // ── Telemetry Scores (0–100 scale) ─────────────────────────────────
  matchScore            Float?            // Overall match percentage
  aiInterviewScore      Float?            // AI interview assessment
  projectScore          Float?            // Project/take-home evaluation
  humanInterviewScore   Float?            // 1-to-1 calibration interview
  overallTelemetryScore Float?            // Weighted composite score

  appliedAt             DateTime          @default(now())
  reviewedAt            DateTime?
  updatedAt             DateTime          @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  candidate           StudentProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobListing          JobListing          @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  telemetrySnapshots  TelemetrySnapshot[]

  @@unique([candidateId, jobListingId]) // One application per candidate per job
  @@index([candidateId])
  @@index([jobListingId])
  @@index([status])
  @@map("applications")
}

/// Granular, point-in-time assessment breakdown for a single application.
/// Each row captures one evaluation dimension (e.g., "Problem Solving", "System Design").
model TelemetrySnapshot {
  id              String        @id @default(cuid())
  applicationId   String
  dimension       String        // e.g., "Problem Solving", "Code Quality", "Communication"
  score           Float         // Achieved score
  maxScore        Float         @default(100)
  evaluatorType   EvaluatorType @default(AI)
  notes           String?
  recordedAt      DateTime      @default(now())

  // ── Relations ──────────────────────────────────────────────────────
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([dimension])
  @@map("telemetry_snapshots")
}

// ═══════════════════════════════════════════════════════════════════════════
// 4. ASSESSMENTS & CODING CHALLENGES
// ═══════════════════════════════════════════════════════════════════════════

enum AssessmentType {
  CODING_CHALLENGE
  SYSTEM_DESIGN
  CODE_REVIEW
  TECHNICAL_QUIZ
}

enum AssessmentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssessmentStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

/// Technical assessment created by platform administrators.
model Assessment {
  id               String               @id @default(cuid())
  title            String
  description      String
  softwareTrack    SoftwareTrack
  type             AssessmentType       @default(CODING_CHALLENGE)
  difficulty       AssessmentDifficulty @default(INTERMEDIATE)
  status           AssessmentStatus     @default(ACTIVE)
  timeLimitMinutes Int                  @default(60)
  passingScore     Int                  @default(75)
  problemStatement String               @db.Text
  starterCode      String               @db.Text
  language         String               @default("TypeScript")
  rubric           Json                 // Evaluation dimensions and weights
  tags             String[]             // Array of domain tags
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  testCases   AssessmentTestCase[]
  submissions AssessmentSubmission[]

  @@index([softwareTrack])
  @@index([difficulty])
  @@index([status])
  @@map("assessments")
}

/// Automated test cases for assessment code execution.
model AssessmentTestCase {
  id             String     @id @default(cuid())
  assessmentId   String
  input          String     @db.Text
  expectedOutput String     @db.Text
  isHidden       Boolean    @default(false)
  explanation    String?
  weight         Int        @default(20)

  // ── Relations ──────────────────────────────────────────────────────
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_test_cases")
}

/// Candidate technical assessment attempts and telemetry progress.
model AssessmentSubmission {
  id                String          @id @default(cuid())
  candidateId       String
  assessmentId      String
  status            String          @default("COMPLETED") // IN_PROGRESS, COMPLETED, EVALUATED
  score             Float?
  passed            Boolean         @default(false)
  codeSolution      String?         @db.Text
  testCasesPassed   Int             @default(0)
  totalTestCases    Int             @default(0)
  executionTimeMs   Int?
  feedbackSummary   String?         @db.Text
  submittedAt       DateTime        @default(now())
  evaluatedAt       DateTime?

  // ── Relations ──────────────────────────────────────────────────────
  candidate  StudentProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([assessmentId])
  @@map("assessment_submissions")
}

// ═══════════════════════════════════════════════════════════════════════════
// 5. CONSULTATIONS & MENTOR SESSIONS
// ═══════════════════════════════════════════════════════════════════════════

enum ConsultationStatus {
  PENDING_APPROVAL
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConsultationTopic {
  CAREER_ROADMAP
  SYSTEM_DESIGN
  CODE_REVIEW
  MOCK_INTERVIEW
  RESUME_CALIBRATION
  PORTFOLIO_CRITIQUE
}

/// 1-on-1 mentor guidance & career roadmap consultation session.
model ConsultationSession {
  id              String             @id @default(cuid())
  studentId       String
  studentName     String
  studentEmail    String
  studentTrack    SoftwareTrack
  mentorId        String
  mentorName      String
  mentorTitle     String
  mentorCompany   String
  topic           ConsultationTopic  @default(CAREER_ROADMAP)
  topicTitle      String
  notes           String?            @db.Text
  scheduledAt     DateTime
  durationMinutes Int                @default(45)
  meetingLink     String?
  status          ConsultationStatus @default(PENDING_APPROVAL)
  rating          Int?
  feedback        String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([mentorId])
  @@index([studentTrack])
  @@index([status])
  @@map("consultation_sessions")
}

// ═══════════════════════════════════════════════════════════════════════════
// 6. SHARED SCHEDULING & SESSIONS BACKEND (Human Interview & Consultations)
// ═══════════════════════════════════════════════════════════════════════════

enum ExpertRole {
  INTERVIEWER
  CONSULTANT
  BOTH

  @@map("expert_role")
}

enum SlotStatus {
  available
  held
  booked
  blocked

  @@map("slot_status")
}

enum SessionType {
  human_interview
  consultation

  @@map("session_type")
}

enum SessionStatus {
  scheduled
  completed
  cancelled
  in_progress
  no_show

  @@map("session_status")
}

enum EvaluationRecommendation {
  STRONG_HIRE
  HIRE
  CALIBRATED_JUNIOR
  NEEDS_PRACTICE

  @@map("evaluation_recommendation")
}

/// Expert mentor and technical interviewer profile
model Expert {
  id                String        @id
  userId            String?       @unique @map("user_id")
  role              ExpertRole    @default(BOTH)
  fullName          String        @map("full_name")
  initials          String?
  title             String
  company           String
  bio               String?       @db.Text
  track             SoftwareTrack @default(BACKEND)
  specialties       String[]
  rating            Decimal       @default(5.00) @db.Decimal(3, 2)
  reviewCount       Int           @default(0) @map("review_count")
  sessionsCompleted Int           @default(0) @map("sessions_completed")
  avatarUrl         String?       @map("avatar_url")
  languages         String[]      @default(["Arabic", "English"])
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  availabilitySlots ExpertAvailabilitySlot[]
  sessions          Session[]     @relation("ExpertSessions")
  evaluations       HumanInterviewEvaluation[]
  internalNotes     HumanInterviewInternalNote[]
  assignments       CandidateInterviewAssignment[]

  @@index([role])
  @@index([track])
  @@index([isActive])
  @@map("experts")
}

/// Expert availability calendar slots
model ExpertAvailabilitySlot {
  id        String     @id @default(uuid()) @db.Uuid
  expertId  String     @map("expert_id")
  startTime DateTime   @map("start_time")
  endTime   DateTime   @map("end_time")
  timezone  String     @default("Asia/Riyadh")
  status    SlotStatus @default(available)
  heldUntil DateTime?  @map("held_until")
  heldBy    String?    @map("held_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  // Relations
  expert   Expert    @relation(fields: [expertId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([expertId, status])
  @@index([startTime])
  @@index([status])
  @@map("expert_availability_slots")
}

/// Shared core booking entity for Human Interview and Consultations
model Session {
  id                       String        @id @default(uuid()) @db.Uuid
  candidateId              String        @map("candidate_id")
  candidateUserId          String        @map("candidate_user_id")
  expertId                 String        @map("expert_id")
  slotId                   String?       @map("slot_id") @db.Uuid
  sessionType              SessionType   @map("session_type")
  status                   SessionStatus @default(scheduled)
  scheduledStartTime       DateTime      @map("scheduled_start_time")
  scheduledEndTime         DateTime      @map("scheduled_end_time")
  timezone                 String        @default("Asia/Riyadh")
  meetingProvider          String?       @default("custom") @map("meeting_provider")
  meetingUrl               String?       @map("meeting_url")
  cancellationReason       String?       @map("cancellation_reason") @db.Text
  cancelledBy              String?       @map("cancelled_by")
  cancelledAt              DateTime?     @map("cancelled_at")
  rescheduledFromSessionId String?       @map("rescheduled_from_session_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  candidate             StudentProfile              @relation("CandidateSessions", fields: [candidateId], references: [id], onDelete: Restrict)
  candidateUser         User                        @relation("CandidateUserSessions", fields: [candidateUserId], references: [id], onDelete: Restrict)
  expert                Expert                      @relation("ExpertSessions", fields: [expertId], references: [id], onDelete: Restrict)
  slot                  ExpertAvailabilitySlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  rescheduledFrom       Session?                    @relation("SessionRescheduleHistory", fields: [rescheduledFromSessionId], references: [id], onDelete: SetNull)
  rescheduledSessions   Session[]                   @relation("SessionRescheduleHistory")
  humanInterviewDetails HumanInterviewDetail?
  consultationDetails   ConsultationDetail?
  evaluation            HumanInterviewEvaluation?

  @@index([candidateUserId])
  @@index([expertId])
  @@index([sessionType, status])
  @@index([scheduledStartTime])
  @@map("sessions")
}

/// Stage 02B Human Technical Calibration specific context
model HumanInterviewDetail {
  id               String        @id @default(uuid()) @db.Uuid
  sessionId        String        @unique @map("session_id") @db.Uuid
  softwareTrack    SoftwareTrack @default(BACKEND) @map("software_track")
  calibrationStage String        @default("Stage 02B: Human Technical Calibration") @map("calibration_stage")
  candidateNotes   String?       @map("candidate_notes") @db.Text
  targetRole       String?       @default("Junior Software Engineer") @map("target_role")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([softwareTrack])
  @@map("human_interview_details")
}

/// 1-to-1 Mentorship specific details, outcome notes, and action items
model ConsultationDetail {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @unique @map("session_id") @db.Uuid
  topic             String
  topicTitle        String   @map("topic_title")
  goal              String?  @db.Text
  candidateMessage  String?  @map("candidate_message") @db.Text
  outcomeSummary    String?  @map("outcome_summary") @db.Text
  actionItems       Json?    @default("[]") @map("action_items")
  deliverables      Json?    @default("{}")
  candidateRating   Int?     @map("candidate_rating")
  candidateFeedback String?  @map("candidate_feedback") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([topic])
  @@map("consultation_details")
}

/// Candidate-visible technical scorecard, score breakdown, and recommendations
model HumanInterviewEvaluation {
  id                       String   @id @default(uuid()) @db.Uuid
  sessionId                String   @unique @map("session_id") @db.Uuid
  evaluatorId              String   @map("evaluator_id")
  technicalScore           Decimal  @map("technical_score") @db.Decimal(5, 2)
  problemSolvingScore      Decimal  @map("problem_solving_score") @db.Decimal(5, 2)
  communicationScore       Decimal  @map("communication_score") @db.Decimal(5, 2)
  reasoningScore           Decimal  @map("reasoning_score") @db.Decimal(5, 2)
  overallScore             Decimal  @map("overall_score") @db.Decimal(5, 2)
  recommendation           String
  candidateVisibleFeedback String   @map("candidate_visible_feedback") @db.Text
  strengths                Json?    @default("[]")
  recommendations          Json?    @default("[]")
  submittedAt              DateTime @default(now()) @map("submitted_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  session      Session                      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluator    Expert                       @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  internalNote HumanInterviewInternalNote?

  @@index([evaluatorId])
  @@index([overallScore])
  @@map("human_interview_evaluations")
}

/// Isolated interviewer-only internal deliberation notes (RLS-gated from candidates)
model HumanInterviewInternalNote {
  id            String   @id @default(uuid()) @db.Uuid
  evaluationId  String   @unique @map("evaluation_id") @db.Uuid
  evaluatorId   String   @map("evaluator_id")
  internalNotes String   @map("internal_notes") @db.Text
  privateFlags  Json?    @default("{}") @map("private_flags")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  evaluation HumanInterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluator  Expert                   @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@map("human_interview_internal_notes")
}

/// Tracks which interviewer is assigned to which candidate (by admin or auto-match)
model CandidateInterviewAssignment {
  id              String   @id @default(uuid()) @db.Uuid
  candidateUserId String   @unique @map("candidate_user_id")
  expertId        String   @map("expert_id")
  assignedBy      String   @default("system") @map("assigned_by")
  assignedAt      DateTime @default(now()) @map("assigned_at")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  candidateUser User   @relation(fields: [candidateUserId], references: [id], onDelete: Cascade)
  expert        Expert @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
  @@map("candidate_interview_assignments")
}
